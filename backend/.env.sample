# ===== LLM PROVIDER TOGGLE =====
# "groq" (cloud, free tier) or "ollama" (local, mandatory for demo)
LLM_PROVIDER=groq

# Groq (cloud) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (local) - must be running: `ollama serve`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ===== DATABASE (MySQL) =====
# Point this at your MySQL Workbench-managed server. If MySQL runs on your
# host machine and the backend runs in Docker, use host.docker.internal
# instead of localhost (see docker-compose.yml comments for why). If MySQL
# runs natively alongside a natively-run backend, localhost is correct.
#
# Create the database first if it doesn't exist:
#   CREATE DATABASE lenny_growth_assistant CHARACTER SET utf8mb4;
#
# Driver is "mysql+aiomysql://" (this app uses SQLAlchemy's async engine
# with the aiomysql driver).
#
# If your password has special characters, percent-encode them first:
#   python3 -c "import urllib.parse; print(urllib.parse.quote('YOUR-PASSWORD', safe=''))"

# Native backend + native MySQL on the same machine:
DATABASE_URL=mysql+aiomysql://root:{Password}@localhost:3306/lenny_growth_assistant

# Backend running in Docker Compose, MySQL running on your host machine:
# DATABASE_URL=mysql+aiomysql://root:{Password}@host.docker.internal:3306/lenny_growth_assistant

# Backend AND MySQL both running in Docker Compose (uncomment the `db` service in docker-compose.yml):
# DATABASE_URL=mysql+aiomysql://root:{password}@db:3306/lenny_growth_assistant

# ===== VECTOR STORE (FAISS, local on disk) =====
FAISS_INDEX_DIR=./data/faiss_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ===== APP =====
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
SESSION_SECRET=change_me_dev_only

# ===== FRONTEND =====
VITE_API_BASE_URL=http://localhost:8000
